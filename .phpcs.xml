<?xml version="1.0"?>
<ruleset name="CmcicMonetico">
    <description>CiviCRM PHP coding standard for the Cmcic Monetico extension.</description>

    <file>CRM</file>
    <file>Civi</file>
    <file>settings</file>
    <file>tests</file>
    <file>cmcic.civix.php</file>
    <file>cmcic.php</file>
    <file>rector.php</file>

    <arg name="colors"/>
    <arg name="extensions" value="php"/>
    <arg value="sp"/>

    <config name="php_version" value="80200"/>
    <config name="installed_paths" value="vendor/drupal/coder/coder_sniffer"/>

    <rule ref="Drupal"/>
</ruleset>
