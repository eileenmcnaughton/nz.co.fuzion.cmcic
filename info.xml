<?xml version="1.0"?>
<extension key="nz.co.fuzion.cmcic" type="module">
  <file>cmcic</file>
  <name>Monetico Online Payment processor</name>
  <description>Payment processor for Monetico Online (Crédit Mutuel / CIC)</description>
  <license>AGPL</license>
  <maintainer>
    <author>Eileen</author>
    <email>eileen@fuzion.co.nz</email>
  </maintainer>
  <maintainer>
    <author>Jonathan Dahan</author>
    <email>jonathan@dhn.one</email>
  </maintainer>
  <releaseDate>2026-08-06</releaseDate>
  <version>1.6</version>
  <develStage>stable</develStage>
  <compatibility>
    <ver>6.10</ver>
  </compatibility>
  <php_compatibility>
    <ver>8.1</ver>
    <ver>8.2</ver>
    <ver>8.3</ver>
    <ver>8.4</ver>
    <ver>8.5</ver>
  </php_compatibility>
  <smarty_compatibility>
    <ver>5</ver>
  </smarty_compatibility>
  <comments>Monetico Online Payment processor (Crédit Mutuel / CIC). You need to configure the CGI2 return URL with your bank to
  https://yoursite/civicrm/payment/ipn/{processor_id}
  where {processor_id} is your CiviCRM gateway payment processor ID.
  </comments>
  <civix>
    <namespace>CRM/Cmcic</namespace>
    <format>25.10.2</format>
  </civix>
  <urls>
    <url desc="Main Extension Page">https://github.com/eileenmcnaughton/nz.co.fuzion.cmcic</url>
    <url desc="Documentation">https://github.com/eileenmcnaughton/nz.co.fuzion.cmcic</url>
    <url desc="Support">https://github.com/eileenmcnaughton/nz.co.fuzion.cmcic</url>
    <url desc="Licensing">http://www.gnu.org/licenses/agpl-3.0.html</url>
  </urls>
  <mixins>
    <mixin>menu-xml@1.0.0</mixin>
    <mixin>mgd-php@2.0.0</mixin>
    <mixin>smarty@1.0.3</mixin>
    <mixin>scan-classes@1.0.0</mixin>
    <mixin>setting-php@1.0.0</mixin>
  </mixins>
  <classloader>
    <psr0 prefix="CRM_" path="."/>
    <psr4 prefix="Civi\" path="Civi"/>
  </classloader>
</extension>
